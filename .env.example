# ============================================
# COMPASS - ENVIRONMENT VARIABLES (example)
# ============================================
#
# Copy this file to `.env`. The UI can also accept credentials at runtime;
# everything below is optional at file-load time.
# ============================================

# --- IBM Bob (required at runtime, from env or UI sidebar) ---
# Get one at https://bob.ibm.com → API keys.  Scope: Inference.
BOB_API_KEY=

# --- MongoDB (optional — falls back to an in-memory dev DB if unset) ---
# For a free hosted cluster, create one at https://cloud.mongodb.com and
# paste the SRV connection string here.  The DB name defaults to "compass".
MONGO_URI=
MONGO_DB=compass

# --- Google OAuth (optional — enables the "Sign in with Google" tab) ---
# Create an OAuth 2.0 Client ID at
#   https://console.cloud.google.com/apis/credentials
# Add http://localhost:8501 (or your stable tunnel URL) as an Authorized
# redirect URI.  Then set both values below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8501

# --- watsonx Orchestrate (optional — only for the workflow demo) ---
# WO_INSTANCE_URL=https://api.<region>.dl.watson-orchestrate.ibm.com/instances/<uuid>
# WO_API_KEY=

# --- Sandbox limits (safe defaults; raise only if you know why) ---
COMPASS_CMD_TIMEOUT_SECONDS=60
COMPASS_CMD_OUTPUT_MAX_BYTES=4096
COMPASS_MAX_BOBCOIN_PER_RUN=5.0
COMPASS_BOB_TIMEOUT_SECONDS=300
COMPASS_BOB_MAX_TURNS=8

# --- Optional Bob entry-point override (only if `bob` is not on PATH) ---
# COMPASS_BOB_ENTRY=C:\Users\...\node_modules\bobshell\dist\bob.js

# ============================================
# NOT NEEDED for the Streamlit UI. Only used by `compass serve` (FastAPI);
# the server auto-generates a token on first launch if unset.
# COMPASS_API_TOKEN=
# ============================================
