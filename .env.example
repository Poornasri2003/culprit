# ============================================
# COMPASS - ENVIRONMENT VARIABLES (example)
# ============================================
#
# Copy this file to `.env`, then either:
#   * fill in BOB_API_KEY here, OR
#   * leave it blank and paste it into the Streamlit sidebar at runtime.
# Never commit your real .env — it is in .gitignore.
# ============================================

# --- IBM Bob (optional at file-load; required at runtime, from env or UI) ---
# Get one at https://bob.ibm.com -> API keys. Scope: Inference.
BOB_API_KEY=

# --- watsonx Orchestrate (optional — only for the workflow demo) ---
# WO_INSTANCE_URL=https://api.<region>.dl.watson-orchestrate.ibm.com/instances/<uuid>
# WO_API_KEY=

# --- Sandbox limits (safe defaults; raise only if you know why) ---
COMPASS_CMD_TIMEOUT_SECONDS=60
COMPASS_CMD_OUTPUT_MAX_BYTES=4096
COMPASS_MAX_BOBCOIN_PER_RUN=5.0
COMPASS_BOB_TIMEOUT_SECONDS=300
COMPASS_BOB_MAX_TURNS=8

# --- Optional Bob entry-point override (only if `bob` is not on PATH) ---
# COMPASS_BOB_ENTRY=C:\Users\...\node_modules\bobshell\dist\bob.js

# ============================================
# NOT NEEDED for the Streamlit UI. Only used by `compass serve` (FastAPI):
#   * COMPASS_API_TOKEN — bearer token clients must send to /ask and /onboard.
# `compass serve` auto-generates one on first launch if you don't set it here.
# ============================================
