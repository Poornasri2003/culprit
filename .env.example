# ============================================
# IBM HACKATHON - ENVIRONMENT VARIABLES
# ============================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env (which is in .gitignore)
#    Command: cp .env.example .env
# 2. Replace placeholder values with your actual credentials
# 3. NEVER commit the .env file to git
# 4. NEVER share your credentials in code or with AI assistants
#
# ============================================

# IBM Bob API key (Scope: Inference) - used by Culprit to call Bob Shell
# Get from: https://bob.ibm.com -> API keys -> Create
BOB_API_KEY=your_bob_api_key_here_DO_NOT_COMMIT

# Demo-only token shared by sample_app/backend and `culprit debug --auth-bearer`
BEARER_TOKEN=culprit-demo-token

# watsonx Orchestrate (optional) - agent that triggers Culprit from chat
# Orchestrate > Settings > API details: service instance URL and Generate API key
WO_INSTANCE_URL=your_orchestrate_instance_url_here
WO_API_KEY=your_orchestrate_api_key_here_DO_NOT_COMMIT
# Bearer token protecting `culprit serve` (scripts/orchestrate_deploy.py generates one)
CULPRIT_API_TOKEN=generated_by_orchestrate_deploy_DO_NOT_COMMIT

# ============================================
# SECURITY REMINDERS:
# - This .env.example file is safe to commit
# - Your actual .env file is in .gitignore
# - Never hardcode credentials in your code
# - Use process.env.VARIABLE_NAME to access values
# - Never share credentials with AI assistants like Bob
# ============================================